<!-- About page of the "better" build: links point at the Better-EhViewer fork (Corresponding Source of this build). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="declaration"
        android:summary="@string/settings_about_declaration_summary"
        android:title="@string/settings_about_declaration"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="author"
        android:title="@string/settings_about_author"
        app:iconSpaceReserved="false" />

    <com.hippo.preference.UrlPreference
        android:key="issues"
        android:title="@string/settings_about_issues"
        app:enableCopying="true"
        app:iconSpaceReserved="false"
        app:url="https://github.com/suhang56/Better-EhViewer/issues" />

    <com.hippo.preference.UrlPreference
        android:key="latest_release"
        android:title="@string/settings_about_latest_release"
        app:enableCopying="true"
        app:iconSpaceReserved="false"
        app:url="https://github.com/suhang56/Better-EhViewer/releases" />

    <com.hippo.preference.UrlPreference
        android:key="source"
        android:title="@string/settings_about_source"
        app:enableCopying="true"
        app:iconSpaceReserved="false"
        app:url="https://github.com/suhang56/Better-EhViewer" />

    <com.hippo.ehviewer.preference.VersionPreference
        android:key="version"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
